<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>1.6.0.3</Version>
        <Platforms>AnyCPU</Platforms>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <Configurations>Debug;Release;Test</Configurations>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Test|AnyCPU'">
        <DefineConstants>$(DefineConstants);TEST;DEBUG</DefineConstants>
    </PropertyGroup>
        
    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\MoreInjuries.Roslyn.SourceGen\MoreInjuries.Roslyn.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <ModBadHygiene>enable</ModBadHygiene>
    </PropertyGroup>

    <Import Project="MoreInjuries.Integration.Mod.DubsBadHygiene.props" />
</Project>